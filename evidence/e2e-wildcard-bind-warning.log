# E-006  (hypothesis undefined)
command: set -u
cd /root/渗透测试/recon/ohsdk/openhands-agent-server
export PYTHONPATH="/root/渗透测试/recon/ohsdk/openhands-agent-server:/root/渗透测试/recon/ohsdk/openhands-sdk:/root/渗透测试/recon/ohsdk/openhands-tools:/root/渗透测试/recon/ohsdk/openhands-workspace"
timeout 26 python3 -m openhands.agent_server --host 0.0.0.0 --port 50102 > /tmp/oh_bind.log 2>&1 &
SRV=$!
sleep 16
echo "=== 启动告警全文 ==="
grep -i -A6 "Binding to all interfaces" /tmp/oh_bind.log | head -14
echo "=== uvicorn 实际绑定 ==="
grep -i "Uvicorn running on" /tmp/oh_bind.log
echo "=== ss 监听 ==="
ss -ltn | grep ':50102'
echo "=== 未认证执行 ==="
curl -sS --max-time 8 -X POST http://127.0.0.1:50102/api/bash/execute_bash_command -H 'Content-Type: application/json' -d '{"command":"id"}' -w '\nHTTP:%{http_code}\n'
echo "=== 关闭 ==="
kill "$SRV" 2>/dev/null; wait "$SRV" 2>/dev/null; sleep 2
ss -ltn | grep ':50102' || echo "port closed"
expect: 显式 --host 0.0.0.0 且无 session_api_keys 时仅打印 warning，uvicorn 仍绑 0.0.0.0，未认证执行返回 200 与 uid=0(root)
repeat: 1  stability: single-run
toolFailureMarkers: none

